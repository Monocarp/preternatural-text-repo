# VITE_API_URL=https://your-production-api.com/api

# For local development, the vite proxy handles /api requests
# pointing to localhost:8000

# Stack Auth (required for authentication)
VITE_STACK_PROJECT_ID=your-project-id
VITE_STACK_PUBLISHABLE_CLIENT_KEY=your-key

# Editor emails (comma-separated, users who can edit)
VITE_EDITOR_EMAILS=you@example.com
