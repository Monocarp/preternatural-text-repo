        "poltergeist": ["poltergeist", "objects moved", "thrown about", "levitated objects", "mysterious torrents"],
        "apparition": ["apparition", "appeared before", "vision of", "saw the figure of", "spectral", "phantom"],
        "haunting": ["haunted", "haunting", "ghost appeared", "specter", "phantom", "haunt"],
        
