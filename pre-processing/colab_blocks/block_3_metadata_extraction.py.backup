    }
}

def extract_domain_topics(content: str) -> Dict:
    """Extract domain-specific topics using pattern matching."""
    content_lower = content.lower()
    
    topics = {
        "primary": [],
        "phenomena": [],
        "entities": [],
        "context": [],
        "all_matches": []
    }
    
    match_counts = {}
    
    for category, patterns in DOMAIN_PATTERNS.items():
        for topic, keywords in patterns.items():
            count = 0
            for keyword in keywords:
                if keyword in content_lower:
                    count += content_lower.count(keyword)
            if count > 0:
                match_counts[topic] = count
                topics[category].append(topic)
                topics["all_matches"].append((topic, count))
    
    # Sort by frequency and pick top topics as primary
    sorted_topics = sorted(match_counts.items(), key=lambda x: x[1], reverse=True)
    topics["primary"] = [t[0] for t in sorted_topics[:3]]
    
    return topics


# ========================== KEYWORD SYNTHESIS ==========================

def synthesize_keywords(title: str, temporal: Dict, locations: Dict, 
                       topics: Dict, existing_keywords: List[str]) -> List[str]:
    """
    Synthesize rich keywords from all extracted metadata.
    Combines: locations, temporal, topics (excludes title to avoid redundancy).
    """
    keywords = set()
    
    # 1. Topics (most important - domain-specific)
    for topic in topics.get("primary", [])[:4]:
        keywords.add(topic.replace("_", " "))
    for topic in topics.get("secondary", [])[:2]:
        keywords.add(topic.replace("_", " "))
    
    # 2. Locations (specific places)
    for city in locations.get("cities", [])[:3]:
        if city:
            keywords.add(city.lower())
    for country in locations.get("countries", [])[:2]:
        if country:
            keywords.add(country.lower())
    for region in locations.get("regions", [])[:1]:
        if region:
            keywords.add(region.lower())
    
    # 3. Temporal (up to 2 most relevant)
    centuries = temporal.get("centuries", [])
    if len(centuries) == 1:
        keywords.add(f"{centuries[0]}th century")
    elif len(centuries) > 1:
        # Add only first and last if range
        keywords.add(f"{centuries[0]}th century")
        if centuries[-1] != centuries[0]:
            keywords.add(f"{centuries[-1]}th century")
    
    # 4. Years (only if highly specific - single year or very narrow range)
    years = temporal.get("years", [])
    if len(years) == 1:
        keywords.add(str(years[0]))
    elif 2 <= len(years) <= 3:
        keywords.add(f"{years[0]}-{years[-1]}")
    
    # 5. Existing keywords ONLY if they're substantive (not generic words)
    # Skip if they appear to be noise from title or common words
    generic_noise = {"used", "made", "found", "seen", "took", "came", "went", "said", "told", 
                     "arm", "hand", "cross", "book", "man", "woman", "time", "day", "night"}
    for kw in existing_keywords:
        if kw and len(kw) > 2:
            kw_lower = kw.lower()
            # Only keep if not a generic word and not already in title
            if kw_lower not in generic_noise and kw_lower not in title.lower():
                keywords.add(kw_lower)
    
    # Return sorted, limited to top 12 most relevant
    return sorted(list(keywords))[:12]


# ========================== CONFIDENCE & VALIDATION ==========================

def calculate_confidence(temporal: Dict, locations: Dict, topics: Dict) -> float:
    """
    Calculate confidence score (0-1) based on extraction quality.
    Equal weighting: 33% temporal, 33% locations, 33% topics.
    """
    score = 0.0
    
    # Temporal (33%)
    has_temporal = bool(temporal.get("years") or temporal.get("centuries"))
    if has_temporal:
        score += 0.33
    
    # Locations (33%)
    has_locations = bool(locations.get("cities") or locations.get("countries"))
    if has_locations:
        score += 0.33
    
    # Topics (33%)
    has_topics = bool(topics.get("primary"))
    if has_topics:
        score += 0.33
    
    # Small bonus for having rich data
    if len(temporal.get("years", [])) >= 2:
        score += 0.01
    if len(locations.get("countries", [])) >= 1:
        score += 0.01
    
    return min(score, 1.0)


def generate_warnings(temporal: Dict, locations: Dict, topics: Dict) -> List[str]:
    """Generate human-readable warnings for review."""
    warnings = []
    
    if not temporal.get("years") and not temporal.get("centuries"):
        warnings.append("No temporal data found - check if story contains dates or century references")
    
    if not locations.get("cities") and not locations.get("countries"):
        raw = locations.get("raw_mentions", [])
        if raw:
            warnings.append(f"Locations not normalized - raw mentions: {raw[:5]}")
        else:
            warnings.append("No locations found in text")
    
    if not topics.get("primary"):
        warnings.append("No primary topics extracted - story may lack supernatural keywords")
    
    return warnings
