        "sabbath": ["sabbath", "witch gathering", "nocturnal assembly", "devils' mass"],
        "familiar_spirit": ["familiar", "familiar spirit", "demon servant", "imp"],
        "shapeshifting": ["shapeshifting", "transformed into", "werewolf", "lycanthropy", "metamorphosis"],
        
        # Mystical phenomena
