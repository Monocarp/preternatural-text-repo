        "prophecy": ["prophecy", "prophesied", "foretold", "predicted", "vision of the future", "precognition"],
        "miracle": ["miracle", "miraculous", "supernatural healing", "divine intervention", "wonder"],
        "visions": ["vision", "visionary", "saw", "beheld", "revelation"],
        
